# ナレッジベースの原本層と生成物層。毎日の差分がコミットに載るのを防ぐ。
# 10-silver/ と 00-system/ はコミット対象。
knowledge/20-bronze/

# 30-gold は生成物層。ディレクトリごと除外すると git が中に降りず
# 「!」による個別の再包含が効かないため、中身を除外する書き方にする。
knowledge/30-gold/*
# 人が読むマニュアルだけは版管理する。
!knowledge/30-gold/ollama-マニュアル.html
!knowledge/30-gold/qwen-ワーカーマニュアル.html
!knowledge/30-gold/リモートで使い方マニュアル.html
!knowledge/30-gold/サーバーでの使い方マニュアル.html
!knowledge/30-gold/Claude サブエージェントとしての Qwen 評価レポート.html

# 秘密値。Open WebUI はカレントディレクトリに鍵を書くことがあるため、
# このリポジトリで作業中に生成されても追跡しない。
.webui_secret_key

# qwen-worker の仮想環境。絶対パスを埋め込むため持ち運べない。
# 再作成: cd tools/qwen-worker && uv venv --python 3.12 .venv
#         && uv pip install --python .venv/bin/python -r requirements.lock.txt
#         && uv pip install --python .venv/bin/python -e .
tools/qwen-worker/.venv/
__pycache__/
*.egg-info/

# local-ai-bridge の仮想環境と生成物。絶対パスを埋め込むため持ち運べない。
# 再作成: cd tools/local-ai-bridge && uv venv --python 3.12 .venv
#         && uv pip install --python .venv/bin/python -r requirements.lock.txt
#         && uv pip install --python .venv/bin/python -e .
tools/local-ai-bridge/.venv/
.pytest_cache/

# 試験用の入れ子リポジトリ。独自の .git を持つ（local-ai-bridge の worktree 分離に必要）。
# localai からは追跡しない。
tools/qwen-worker/fixtures/
tools/local-ai-bridge/fixtures/
tools/local-ai-bridge/bench/ab-benchmark/

# hunyuan3d の仮想環境・上流ソース・モデルの重み・生成物。
# いずれも大きいか絶対パスを埋め込むため持ち運べない。
# 再作成: tools/hunyuan3d/setup-server.sh
tools/hunyuan3d/.venv/
tools/hunyuan3d/vendor/
tools/hunyuan3d/models/
tools/hunyuan3d/outputs/
tools/hunyuan3d/fixtures/

# Claude Code が作る一時 worktree。リポジトリの複製なので追跡しない。
.claude/worktrees/

# 貼り付けた画像などの一時置き場。
zzz-Temp/

# pixal3d の仮想環境・上流ソース・ビルド用の一時 clone・モデルの重み・生成物。
# いずれも大きいか絶対パスを埋め込むため持ち運べない。
# 再作成: tools/pixal3d/setup-server.sh
tools/pixal3d/.venv/
tools/pixal3d/vendor/
tools/pixal3d/models/
tools/pixal3d/outputs/
tools/pixal3d/fixtures/
