      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (A30 local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3.8:27b": {
          "name": "Qwen3.8 27B (local A30)"
