[Unit]
Description=Strata (Qwen3.8-Flash-Next Coder IQ1_M, OpenAI-compatible API, port 8083)
# 汎用版（strata.service）と同じ engine で動くコード向け版。RAM と VRAM を取り合うので同時には載せない。
# Conflicts= により、こちらを start すると systemd が strata.service と strata-official.service を止める（逆も同じ）。
Conflicts=strata.service strata-official.service
# Conflicts= だけでは止める順番が決まらない。2 つの間に順序の関係（After= か Before= のどちらか一方）があれば、
# systemd は停止の job を起動の job より先に行う（systemd.unit の Conflicts=）。汎用版の側には書かない
# （両方に After= を書くと順序が輪になる）。これで、どちらを start しても、もう一方が RAM を返してから読み込む。
# 公式版（strata-official.service）との順序は、公式版の側の After=strata-coder.service で決まる（こちらには書かない）。
# Ollama と VRAM を食い合うので、Ollama のユニットには依存させない。起動前に Ollama のモデルを降ろすこと
# （エキスパートのキャッシュは起動時の空き VRAM で決まる）。ComfyUI / Hunyuan3D / Pixal3D とも RAM と VRAM を取り合う。
After=network.target strata.service
# 読み込みに数分かかるので、失敗の繰り返しは 30 分に 3 回までにする（既定の 10 秒に 5 回では止まらない）。
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=simple
# インストール先に合わせて書き換える。既定は tools/strata をこのパスに置いた場合。
WorkingDirectory=%h/Proj/localai/tools/strata
# STRATA_MAX_CONTEXT・STRATA_REASONING_BUDGET_TOKENS・STRATA_EXTRA_ARGS・STRATA_API_KEY などを読む（汎用版の strata.env とは別のファイル）。
# 先頭の "-" はファイルが無くてもエラーにしない意味。
EnvironmentFile=-%h/.config/strata/strata-coder.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/Proj/localai/tools/strata/run-strata serve --model coder
# 上流のサーバーは engine の読み込みが終わってから待受を始める。API が応答するまで start を終えない
# （systemctl --user start strata-coder が戻った時点で使える）。TimeoutStartSec より少し短くする。
ExecStartPost=%h/Proj/localai/tools/strata/run-strata wait-ready --model coder --timeout 880
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
# SIGTERM で上流のサーバーが engine に QUIT を送り、固定した RAM を返してから終わる。
TimeoutStopSec=120
# engine はエキスパートの RAM 複製を cudaHostRegister で固定し、残りを mlock で留める（docs/INSTALL.md:101）。
# user ユニットでは systemd --user 自身の上限（この機体では 7.8 GiB）より上げられない。README の「memlock の扱い」。
LimitMEMLOCK=infinity
# RAM の安全弁。上限に当たったサービスだけがカーネルに落とされ、デスクトップは巻き込まれない。
# 値は 2026-10-07 の実測で決めた（README の「コード向け版（Coder）」）。
# - 落とせない分は約 26.2 GiB: ページロックしたエキスパート 23.42 GiB を含む anon 25.2（約 7.8 万トークンの入力で
#   25.65）+ shmem 0.5 + kernel 0.15。残りは GGUF を読んだときの page cache で、上限まで溜まるが捨てられる。
# - 32G/36G・40G/44G のどちらでも cgroup は MemoryHigh に張り付くが、起動（冷えた状態で 14 秒）・prefill・生成は
#   変わらず、PSI の待ちもほぼ 0 だった。間を取り、page cache と長い入力の増分に約 10 GiB を残す 36G にした。
# - MemoryMax=40G は落とせない分より 13.8 GiB 上。機体（62.5 GiB）に 22 GiB 以上を残す。
MemoryHigh=36G
MemoryMax=40G

[Install]
WantedBy=default.target
