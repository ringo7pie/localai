[Unit]
Description=Strata (Qwen3.8-Flash-Next IQ3_XXS official, not abliterated, OpenAI-compatible API, port 8084)
# 汎用版（strata.service）・コード向け版（strata-coder.service）と同じ engine で動く公式版（非 abliterated）。
# RAM と VRAM を取り合うので同時には載せない。Conflicts= により、こちらを start すると systemd が strata.service・
# strata-coder.service・strata-official-iq3s.service・strata-swift.service を止める（逆も同じ）。
Conflicts=strata.service strata-coder.service strata-official-iq3s.service strata-swift.service
# Conflicts= だけでは止める順番が決まらない。2 つの間に順序の関係（After= か Before= のどちらか一方）があれば、
# systemd は停止の job を起動の job より先に行う（systemd.unit の Conflicts=）。順序は一方向の鎖
# strata → strata-coder → strata-official → strata-official-iq3s → strata-swift で、自分より前の 2 つだけをこちらに書く
# （後ろの 2 つとの順序は、それぞれの側の After=strata-official.service で決まる）。輪にならない。
# これで、どれを start しても、ほかが RAM を返してから読み込む。
# Ollama と VRAM を食い合うので、Ollama のユニットには依存させない。起動前に Ollama のモデルを降ろすこと
# （エキスパートのキャッシュは起動時の空き VRAM で決まる）。ComfyUI / Hunyuan3D / Pixal3D とも RAM と VRAM を取り合う。
After=network.target strata.service strata-coder.service
# 読み込みに数分かかるので、失敗の繰り返しは 30 分に 3 回までにする（既定の 10 秒に 5 回では止まらない）。
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=simple
# リポジトリのパスは、setup-server.sh が雛形の印をこの機体の絶対パスに置き換えて書く（scripts/lib/render-unit.sh）。手で写すときは自分で置き換える。
WorkingDirectory=@REPO_ROOT@/tools/strata
# STRATA_MAX_CONTEXT・STRATA_REASONING_BUDGET_TOKENS・STRATA_EXTRA_ARGS・STRATA_API_KEY などを読む（strata.env・
# strata-coder.env とは別のファイル）。先頭の "-" はファイルが無くてもエラーにしない意味。
EnvironmentFile=-%h/.config/strata/strata-official.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@REPO_ROOT@/tools/strata/run-strata serve --model official
# 上流のサーバーは engine の読み込みが終わってから待受を始める。API が応答するまで start を終えない
# （systemctl --user start strata-official が戻った時点で使える）。TimeoutStartSec より少し短くする。
ExecStartPost=@REPO_ROOT@/tools/strata/run-strata wait-ready --model official --timeout 880
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
# SIGTERM で上流のサーバーが engine に QUIT を送り、固定した RAM を返してから終わる。
TimeoutStopSec=120
# engine はエキスパートの RAM 複製を cudaHostRegister で固定し、残りを mlock で留める（docs/INSTALL.md:101）。
# user ユニットでは systemd --user 自身の上限（この機体では 7.8 GiB）より上げられない。README の「memlock の扱い」。
LimitMEMLOCK=infinity
# RAM の安全弁。上限に当たったサービスだけがカーネルに落とされ、デスクトップは巻き込まれない。
# 値は汎用版（strata.service.example）と同じ 50G / 58G。2026-10-17 の実測で確かめた（README の「公式版」の「速さの設定」）:
# - 2026-10-17 から、エキスパート 39.97 GiB（stra/config.py の OFFICIAL.expert_bytes）を全部 RAM に写してページロックする通常のモード
#   （resident 版より 8〜20% 速い）。落とせない分は約 42.3 GiB: anon 41.45 + shmem 0.49 + kernel 約 0.35。残りは GGUF を読んだときの
#   page cache で、上限まで溜まるが捨てられる（memory.peak 50.00 GiB = MemoryHigh）。起動 41 秒。
# - resident 版（2026-10-07〜16）のときは落とせない分 約 30.2 GiB（shmem 28.4 + anon 1.6）だった。
# MemoryMax=58G は 2026-10-09 の利用者の指示で 54G から上げた（汎用版 strata.service.example と同じ理由・同じ値）。
MemoryHigh=50G
MemoryMax=58G

[Install]
WantedBy=default.target
