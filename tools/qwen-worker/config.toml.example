# qwen-worker の設定雛形。tools/qwen-worker/setup-server.sh が ~/.config/qwen-worker/config.toml として複製する。
# 値はこの A30 サーバー（this-host）の実設定と同じ。別の環境では allowed_roots とパスを見直すこと。

# qwen-worker 設定
# このファイルは人間が編集する。ワーカーは起動時に読むだけで書き換えない。
#
# 注意: TOML ではテーブル見出し（[xxx]）より後ろに書いた key = value は
# そのテーブルの中に入る。トップレベルの値は必ずファイル先頭側に置くこと。

# 許可ルート。ここに無いパスは project_root として受け付けない。
# モデルが指定したパスだけを根拠にアクセスは許可しない。
allowed_roots = [
  "/home/mt/Proj",
]

# 読み込み・複製の対象から常に外すパターン（秘密情報）
denied_globs = [
  "**/.env", "**/.env.*", "**/*.pem", "**/*.key", "**/*.p12", "**/*.pfx",
  "**/id_rsa*", "**/id_ed25519*", "**/.ssh/**", "**/.netrc",
  "**/credentials*", "**/auth.json", "**/secrets*", "**/*secret*",
  "**/.aws/**", "**/.gnupg/**", "**/.claude.json", "**/.codex/**",
]

[ollama]
base_url            = "http://127.0.0.1:11434"
model               = "qwen3.8:27b"
connect_timeout_sec = 10
read_timeout_sec    = 900        # 1 リクエストの上限。ジョブ期限より短くする。

[limits]
job_deadline_sec      = 1800     # ジョブ全体の期限
max_rounds            = 12       # エージェントループの上限ラウンド数
max_repair_retries    = 2        # 同じ失敗に対する修正再試行
lock_wait_sec         = 30       # 推論ロック取得の待機上限。超えたら busy を返す
max_tool_result_chars = 20000    # 1 ツール結果の上限（文脈保護）
inline_diff_max_lines = 400      # この行数以下なら差分本文も結果に含める（リモート利用向け）

[profiles.standard]
num_ctx              = 65536
num_predict          = 8192
think                = true
# 実測: num_ctx=65536 でも Ollama が取り込むのは 32770 トークンまでで、
# それを超えると入力の先頭が黙って落ちる。推定器は実測比で約 1.3 倍に出るので、
# 推定 24000 は実測でおよそ 18000 トークン。ツール結果が積もるぶんの余裕を残してある。
input_budget_tokens  = 24000
enabled              = true

[profiles.large]
num_ctx              = 131072
num_predict          = 16384
think                = true
input_budget_tokens  = 90000
enabled              = false
# 実測 2026-09-19: 131072 は 28%/72% CPU/GPU、98304 は 19%/81%、81920 は 9%/91% と
# いずれも KV キャッシュが CPU に溢れた。65536 だけが 100% GPU。
# A30 24GiB ではこのプロファイルは成立しない。タスク分割で対応する。
disabled_reason      = "131072 も 98304 も CPU オフロードが発生し実測検証に不合格（2026-09-19）。この GPU では使用不可。"

[profiles.extract]
num_ctx              = 65536
num_predict          = 4096
think                = false
input_budget_tokens  = 24000
enabled              = true

# Qwen3.8 公式モデルカード由来の初期値。
# Ollama 側の対応名に読み替えてある（repetition_penalty -> repeat_penalty）。
[sampling.thinking]
temperature      = 1.0
top_p            = 0.95
top_k            = 20
min_p            = 0.0
presence_penalty = 0.0
repeat_penalty   = 1.0

[sampling.non_thinking]
temperature      = 0.7
top_p            = 0.80
top_k            = 20
min_p            = 0.0
presence_penalty = 1.5
repeat_penalty   = 1.0
