# qwen-worker の設定雛形。tools/qwen-worker/setup-server.sh が ~/.config/qwen-worker/config.toml として複製する。
# 値はこの A30 サーバーの実設定と同じ。別の環境では allowed_roots とパスを見直すこと。

# qwen-worker 設定
# このファイルは人間が編集する。ワーカーは起動時に読むだけで書き換えない。
#
# 注意: TOML ではテーブル見出し（[xxx]）より後ろに書いた key = value は
# そのテーブルの中に入る。トップレベルの値は必ずファイル先頭側に置くこと。

# 許可ルート。ここに無いパスは project_root として受け付けない。
# モデルが指定したパスだけを根拠にアクセスは許可しない。
# setup-server.sh が @REPO_ROOT@ をこの clone の絶対パスにして置く。ほかのプロジェクトも渡すときは、
# その親ディレクトリ（実在するディレクトリ）をここに足す。
allowed_roots = [
  "@REPO_ROOT@",
]

# 読み込み・複製の対象から常に外すパターン（秘密情報）
denied_globs = [
  "**/.env", "**/.env.*", "**/*.pem", "**/*.key", "**/*.p12", "**/*.pfx",
  "**/id_rsa*", "**/id_ed25519*", "**/.ssh/**", "**/.netrc",
  "**/credentials*", "**/auth.json", "**/secrets*", "**/*secret*",
  "**/.aws/**", "**/.gnupg/**", "**/.claude.json", "**/.codex/**",
]

[ollama]
base_url            = "http://127.0.0.1:11434"
# ここに書くのは「呼び出し側が model 引数を省略したときの既定」。
# qwen_research / qwen_implement は呼び出しごとに model 引数でこの機体にある
# 任意のモデル（例 gemma4:e4b、gemma4:31b-ctx32k）を選べる。存在しないモデル名は
# 実行前に弾かれ、使えるモデルの一覧（/api/tags 由来）が返る。
# 実測（A30・OLLAMA_CONTEXT_LENGTH=65536）:
#   qwen3.8:27b        16.5GB 100%GPU 23-26 tok/s  既定。実績あり
#   gemma4:e4b          8.9GB 100%GPU 81.5 tok/s   速い。下調べ・要約向き
#   gemma4:31b-ctx32k  17.6GB 100%GPU 29.9 tok/s    賢くて比較的速い
#   qwen3.8-flash-next 系（IQ1_M 等）67-112GB 43%GPU 6.9 tok/s  CPU に溢れる。非推奨
# モデル切替はロードに 13-60 秒かかるため、1 タスクは 1 モデルに固定する運用にする。
model               = "qwen3.8:27b"
connect_timeout_sec = 10
read_timeout_sec    = 900        # 1 リクエストの上限。ジョブ期限より短くする。
# Ollama の構造化出力（format に JSON Schema を渡す）を使うかどうか。既定 false。
# true にしても、いまのワーカーはツール呼び出し（report_findings / report_changes）
# だけで最終回答を受け取っており、format を使う「ツール呼び出し後の最終まとめ」段が
# 実装にまだ無いため、現状は配線だけで未使用（README「構造化出力」参照）。
structured_output   = false

[limits]
job_deadline_sec      = 1800     # ジョブ全体の期限
max_rounds            = 12       # エージェントループの上限ラウンド数
max_repair_retries    = 2        # 同じ失敗に対する修正再試行
lock_wait_sec         = 30       # 推論ロック取得の待機上限。超えたら busy を返す
max_tool_result_chars = 20000    # 1 ツール結果の上限（文脈保護）
inline_diff_max_lines = 400      # この行数以下なら差分本文も結果に含める（リモート利用向け）

[profiles.standard]
num_ctx              = 65536
num_predict          = 8192
think                = true
# 実測: num_ctx=65536 でも Ollama が取り込むのは 32770 トークンまでで、
# それを超えると入力の先頭が黙って落ちる。推定器は実測比で約 1.3 倍に出るので、
# 推定 24000 は実測でおよそ 18000 トークン。ツール結果が積もるぶんの余裕を残してある。
input_budget_tokens  = 24000
enabled              = true

[profiles.large]
num_ctx              = 131072
num_predict          = 16384
think                = true
input_budget_tokens  = 90000
enabled              = false
# 実測 2026-09-19: 131072 は 28%/72% CPU/GPU、98304 は 19%/81%、81920 は 9%/91% と
# いずれも KV キャッシュが CPU に溢れた。65536 だけが 100% GPU。
# A30 24GiB ではこのプロファイルは成立しない。タスク分割で対応する。
disabled_reason      = "131072 も 98304 も CPU オフロードが発生し実測検証に不合格（2026-09-19）。この GPU では使用不可。"

[profiles.extract]
num_ctx              = 65536
num_predict          = 4096
think                = false
input_budget_tokens  = 24000
enabled              = true

# Qwen3.8 公式モデルカード由来の初期値。
# Ollama 側の対応名に読み替えてある（repetition_penalty -> repeat_penalty）。
[web]
# Qwen にインターネット検索（web_search）とページ取得（fetch_url）をさせるかどうか。
# true の間は Qwen の判断で外部へ HTTP リクエストが飛ぶ（DuckDuckGo 検索、任意 URL の取得）。
# 内部アドレス（127.0.0.1、192.168/16、10/8、172.16/12、169.254/16 など。この機体で動く
# Ollama・Open WebUI・入口ページを含む）へは validate_url が拒否するため到達できない。
# 無効にするには enabled を false にする（ツール仕様ごとモデルへ渡さなくなる）。
enabled                 = true
max_searches_per_task   = 10   # 1 タスクでの web_search 呼び出し上限
max_fetches_per_task    = 10   # 1 タスクでの fetch_url 呼び出し上限

[sampling.thinking]
temperature      = 1.0
top_p            = 0.95
top_k            = 20
min_p            = 0.0
presence_penalty = 0.0
repeat_penalty   = 1.0

[sampling.non_thinking]
temperature      = 0.7
top_p            = 0.80
top_k            = 20
min_p            = 0.0
presence_penalty = 1.5
repeat_penalty   = 1.0

# モデルごとのサンプリング上書き。キーは model 引数と同じ Ollama タグ名
# （コロンを含むので必ずクォートする）。thinking / non_thinking は個別に省略でき、
# 省略した側と、ここに無いモデルは上の [sampling.thinking] / [sampling.non_thinking]
# （Qwen3.8 向けの既定）にそのままフォールバックする。
# Gemma 4 の公式既定は temperature=1, top_k=64, top_p=0.95 で、Qwen（top_k=20）とは違う。
# 以下は例。実際に使う場合はコメントを外すこと（既定では無効＝コメントのまま）。
# [model_sampling."gemma4:e4b".thinking]
# temperature      = 1.0
# top_p            = 0.95
# top_k            = 64
# min_p            = 0.0
# presence_penalty = 0.0
# repeat_penalty   = 1.0
#
# [model_sampling."gemma4:e4b".non_thinking]
# temperature      = 1.0
# top_p            = 0.95
# top_k            = 64
# min_p            = 0.0
# presence_penalty = 0.0
# repeat_penalty   = 1.0
#
# [model_sampling."gemma4:31b-ctx32k".thinking]
# temperature      = 1.0
# top_p            = 0.95
# top_k            = 64
# min_p            = 0.0
# presence_penalty = 0.0
# repeat_penalty   = 1.0

# トークン推定（tokens.py）の文字/トークン比。既定は Qwen3.8 実測ベース。
# 変更しない。モデルごとの上書きは [tokens.model_overrides."<モデル名>"] に書けるが、
# Gemma 4 など Qwen 以外は未実測のため、ここには意図的に何も書いていない
# （＝ Gemma 4 の入力予算チェックは Qwen 向けの係数のままで、ずれる可能性がある。
# README「モデルを選ぶ」参照）。
[tokens]
ascii_chars_per_token     = 3.2
non_ascii_chars_per_token = 1.0
