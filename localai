# 結果の集計と表示。
TEST_OK_COUNT=0
TEST_FAIL_COUNT=0
TEST_SKIP_COUNT=0
TEST_VERBOSE=false

report_test() {
  local status="$1"
  local name="$2"
  local detail="$3"
  local color=""
  local mark=""
  case "$status" in
    OK)
      TEST_OK_COUNT=$((TEST_OK_COUNT + 1))
      color="$COLOR_OK"
      mark="[ OK ]"
      ;;
    SKIP)
      TEST_SKIP_COUNT=$((TEST_SKIP_COUNT + 1))
      color="$COLOR_WARN"
      mark="[SKIP]"
      ;;
    *)
      TEST_FAIL_COUNT=$((TEST_FAIL_COUNT + 1))
      color="$COLOR_NG"
      mark="[FAIL]"
      ;;
  esac
  printf '%s%s%s %s: %s\n' "$color" "$mark" "$COLOR_RESET" "$name" "$detail"
}

# コマンドを走らせ、pytest の最後の 1 行（"203 passed in 36.54s" など）を TEST_SUMMARY に、
# 全出力を TEST_OUTPUT に、終了コードを TEST_EXIT_CODE に入れる。
run_test_command() {
  TEST_OUTPUT=""
  TEST_EXIT_CODE=0
  if TEST_OUTPUT="$("$@" 2>&1)"; then
    TEST_EXIT_CODE=0
  else
    TEST_EXIT_CODE=$?
  fi
  TEST_SUMMARY="$(printf '%s\n' "$TEST_OUTPUT" | grep -v '^[[:space:]]*$' | tail -n 1 || true)"
}

# 1 件の結果を出す。TEST_EXIT_CODE が 0 なら OK、pytest の 5（試験が 1 件も無い）と他は FAIL。
finish_test() {
  local name="$1"
  local elapsed_sec="$2"
  if [ "$TEST_EXIT_CODE" -eq 0 ]; then
    report_test OK "$name" "${TEST_SUMMARY:-通った}（${elapsed_sec} 秒）"
    if $TEST_VERBOSE; then
      printf '%s\n' "$TEST_OUTPUT" | sed 's/^/       | /'
    fi
  else
    report_test FAIL "$name" "終了コード $TEST_EXIT_CODE（${elapsed_sec} 秒）: ${TEST_SUMMARY}"
    printf '%s\n' "$TEST_OUTPUT" | tail -n 40 | sed 's/^/       | /'
  fi
}

# uvx で pytest を走らせる。使い方: uvx_pytest <uvx の追加引数...> -- <pytest の引数...>
uvx_pytest() {
  local -a uvx_args=(--python "$TEST_PYTHON_VERSION" --with pytest)
  while [ "$#" -gt 0 ] && [ "$1" != "--" ]
  do
    uvx_args+=("$1")
    shift
  done
  if [ "$#" -gt 0 ]; then
    shift
  fi
  PYTHONDONTWRITEBYTECODE=1 uvx "${uvx_args[@]}" pytest -p no:cacheprovider -q "$@"
}

# venv があって pytest と対象のパッケージを import できれば venv で、無ければ uvx で lock の依存を入れて走らせる。
# PYTHONPATH にツールのディレクトリを足し、editable install されていない作業コピーでも現在のソースを試す。
# 使い方: tool_pytest <ツールのディレクトリ（リポジトリ相対）> <import するパッケージ> -- <pytest の引数...>
tool_pytest() {
  local tool_dir="$1"
  local package_name="$2"
  shift 2
  if [ "$#" -gt 0 ] && [ "$1" = "--" ]; then
    shift
  fi
  local venv_python="$REPO_ROOT/$tool_dir/.venv/bin/python"
  if [ -x "$venv_python" ] && "$venv_python" -c "import pytest, $package_name" >/dev/null 2>&1; then
    PYTHONPATH="$REPO_ROOT/$tool_dir" PYTHONDONTWRITEBYTECODE=1 \
      "$venv_python" -m pytest -p no:cacheprovider -q "$@"
  else
    PYTHONPATH="$REPO_ROOT/$tool_dir" uvx_pytest --with-requirements "$tool_dir/requirements.lock.txt" -- "$@"
  fi
}

# 試験 1 件の実体。成功は TEST_EXIT_CODE=0。出力は呼び出し側が run_test_command で受ける。
