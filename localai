# ================================================================ start / stop / restart / status

# 入口ページが応答しているか（/api/status が JSON を返すか）。
portal_is_up() {
  if http_request GET "$PORTAL_URL/api/status" 3 && [ "$HTTP_CODE" = "200" ] && [[ "$HTTP_BODY" == *'"services"'* ]]; then
    return 0
  fi
  return 1
}

# portal の起動・停止の応答（JSON）を表示し、ok なら 0、そうでなければ 1 を返す。
print_portal_action_result() {
  local key="$1"
  local parsed
  if ! command -v python3 >/dev/null 2>&1 || ! parsed="$(printf '%s' "$HTTP_BODY" | python3 -I -c '
import json
import sys

data = json.load(sys.stdin)
print("ok" if data.get("ok") else "ng")
print(data.get("message", ""))
print(data.get("state", ""))
print("、".join(data.get("stopped") or []))
print("、".join(data.get("unloaded_models") or []))
' 2>/dev/null)"; then
    echo "$key: 応答（HTTP $HTTP_CODE）: ${HTTP_BODY:0:300}"
    [ "$HTTP_CODE" = "200" ]
    return
  fi
  local -a fields
  mapfile -t fields <<<"$parsed"
  echo "${fields[1]:-}"
  if [ -n "${fields[3]:-}" ]; then
    echo "  先に停止したサービス: ${fields[3]}"
  fi
  if [ -n "${fields[4]:-}" ]; then
    echo "  VRAM から降ろした Ollama のモデル: ${fields[4]}"
  fi
  if [ "${fields[0]:-}" != "ok" ] && [ "$HTTP_CODE" = "409" ]; then
    echo "  未導入。$(install_hint "$key")"
  fi
  [ "${fields[0]:-}" = "ok" ]
}

control_via_portal() {
  local action="$1"
  local key="$2"
  local timeout_sec=300
  if [ "$action" = "stop" ]; then
    timeout_sec=120
  fi
  if ! http_request POST "$PORTAL_URL/api/service/$key/$action" "$timeout_sec" "X-Portal-Request: 1"; then
    echo "エラー: 入口ページ（$PORTAL_URL）への要求が失敗しました。" >&2
    return 1
  fi
  print_portal_action_result "$key"
}

control_direct() {
  local action="$1"
  local key="$2"
  if ! command -v systemctl >/dev/null 2>&1 || ! run_with_timeout 5 systemctl --user show-environment >/dev/null 2>&1; then
    echo "エラー: systemctl --user が使えません。./localai doctor で確かめてください。" >&2
    return 1
  fi
  local load_state
  load_state="$(systemctl --user show "$key" --property=LoadState 2>/dev/null | sed -n 's/^LoadState=//p' || true)"
  if [ "$load_state" != "loaded" ]; then
    echo "$key: 未導入。$(install_hint "$key")" >&2
    return 1
  fi

  if [ "$action" != "stop" ] && is_gpu_service_key "$key"; then
    echo "警告: 入口ページ（$PORTAL_URL）が応答していないため、GPU の排他と Ollama のアンロードは行われません。" >&2
    echo "  ほかの GPU サービスを自分で止めてください（VRAM 24 GiB は 1 つしか載りません）。" >&2
    local other_key
    local active_keys=""
    for other_key in "${GPU_SERVICE_KEYS[@]}"
    do
      if [ "$other_key" != "$key" ] && port_belongs_to_unit "$other_key"; then
        active_keys="$active_keys $other_key"
      fi
    done
    if [ -n "$active_keys" ]; then
      echo "  いま動いているもの:$active_keys（systemctl --user stop <名前>）" >&2
    fi
    echo "  Ollama にモデルが載っていれば降ろす: ollama ps / ollama stop <モデル名>" >&2
  fi

  case "$action" in
    start)
      # --no-block: Strata の unit は API が応答するまで（最大 15 分）systemctl start が戻らない。
      systemctl --user start --no-block "$key"
      echo "$key の起動を要求しました。準備できるまで数十秒〜数分かかります（./localai status $key）。"
      ;;
    restart)
      systemctl --user restart --no-block "$key"
      echo "$key の再起動を要求しました（./localai status $key）。"
      ;;
    stop)
      systemctl --user stop "$key"
      echo "$key を停止しました。"
      ;;
  esac
}

# start | stop | restart の本体。portal 自身は入口ページの API の対象外なので常に systemctl を使う。
run_control() {
  local action="$1"
  local key="${2:-}"
  if [ -z "$key" ]; then
    die_usage "$action にはサービス名が要ります（${SERVICE_KEYS[*]}）"
  fi
  if ! is_service_key "$key"; then
    die_usage "未知のサービス: $key（${SERVICE_KEYS[*]}）"
  fi
  if [ "$key" != "portal" ] && portal_is_up; then
    if [ "$action" = "restart" ]; then
      control_via_portal stop "$key" && control_via_portal start "$key"
    else
      control_via_portal "$action" "$key"
    fi
  else
    control_direct "$action" "$key"
  fi
}

# 入口ページの /api/status を、1 サービス 1 行に整形する。引数があればその key だけ。
print_portal_status() {
  local only_key="${1:-}"
  printf '%s' "$HTTP_BODY" | python3 -I -c '
import json
import sys

only_key, portal_url = sys.argv[1], sys.argv[2]
labels = {"running": "稼働中", "starting": "起動中", "stopped": "停止中", "not_installed": "未導入"}
data = json.load(sys.stdin)
if not only_key:
    gpu = data.get("gpu") or {}
    if gpu.get("available"):
        print("GPU: VRAM %s / %s MiB 使用中" % (gpu.get("used_mib"), gpu.get("total_mib")))
    else:
        print("GPU: 取得できない")
    ollama = data.get("ollama") or {}
    if ollama.get("reachable"):
        models = [model.get("name", "?") for model in ollama.get("models", [])]
        print("Ollama: 応答あり。載っているモデル: %s" % ("、".join(models) if models else "なし"))
    else:
        print("Ollama: 応答なし")
    print("portal: 稼働中（%s）" % portal_url)
for service in data.get("services", []):
    if only_key and service.get("key") != only_key:
        continue
    print("%s: %s（:%s）" % (service.get("key"), labels.get(service.get("state"), service.get("state")), service.get("port")))
' "$only_key" "$PORTAL_URL"
}

# systemd の状態を直接読んで 1 行にする（入口ページが応答しないとき）。
print_direct_status() {
  local key="$1"
  local port
  port="$(service_port "$key")"
  local load_state="" active_state="" label
  if command -v systemctl >/dev/null 2>&1; then
    local show_output
    show_output="$(run_with_timeout 5 systemctl --user show "$key" --property=LoadState --property=ActiveState 2>/dev/null || true)"
    load_state="$(printf '%s\n' "$show_output" | sed -n 's/^LoadState=//p')"
    active_state="$(printf '%s\n' "$show_output" | sed -n 's/^ActiveState=//p')"
  fi
  if [ -z "$load_state" ]; then
    label="状態不明（systemctl --user が使えない）"
  elif [ "$load_state" != "loaded" ]; then
    label="未導入"
  elif port_is_listening "$port"; then
    label="稼働中"
  elif [ "$active_state" = "active" ] || [ "$active_state" = "activating" ]; then
    label="起動中"
  else
    label="停止中"
  fi
  echo "$key: $label（:$port）"
}

run_status() {
  local key="${1:-}"
  if [ -n "$key" ] && ! is_service_key "$key"; then
    die_usage "未知のサービス: $key（${SERVICE_KEYS[*]}）"
  fi
  if portal_is_up && command -v python3 >/dev/null 2>&1; then
    if [ "$key" = "portal" ]; then
      echo "portal: 稼働中（$PORTAL_URL）"
    else
      print_portal_status "$key"
    fi
    return 0
  fi
  echo "入口ページ（$PORTAL_URL）が応答していません。systemd の状態を直接読みます。" >&2
  local target_key
  if [ -n "$key" ]; then
    print_direct_status "$key"
  else
    for target_key in "${SERVICE_KEYS[@]}"
    do
      print_direct_status "$target_key"
    done
  fi
}

