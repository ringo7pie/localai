    comfyui) echo "tools/comfyui/tests/test_units.py" ;;
    strata) echo "tools/strata/tests" ;;
    qwen-worker) echo "tools/qwen-worker/tests" ;;
    local-ai-bridge) echo "tools/local-ai-bridge/tests" ;;
    model-eval) echo "tools/model-eval/tests" ;;
    *) echo "" ;;
  esac
}

print_test_list() {
  local name
  echo "走らせる試験（--only <名前>。複数は --only を重ねるかコンマで区切る）:"
  for name in "${TEST_NAMES[@]}"
  do
    printf '  %-22s %s\n' "$name" "$(test_description "$name")"
  done
  echo "常に SKIP（実機が要る。手で流す）:"
  for name in "${TEST_SKIP_NAMES[@]}"
  do
    printf '  %-22s %s\n' "$name" "$(test_description "$name")"
  done
}

run_test() {
  local -a selected=()
  local list_only=false
  local argument
  while [ "$#" -gt 0 ]
  do
    argument="$1"
    case "$argument" in
      --only)
        if [ "$#" -lt 2 ]; then
          die_usage "--only には試験の名前が要ります（./localai test --list）"
        fi
        local -a only_names
        IFS=',' read -r -a only_names <<<"$2"
        selected+=("${only_names[@]}")
        shift 2
        ;;
      --only=*)
        local -a only_inline
        IFS=',' read -r -a only_inline <<<"${argument#--only=}"
        selected+=("${only_inline[@]}")
        shift
        ;;
      --list)
        list_only=true
        shift
        ;;
      -v | --verbose)
        TEST_VERBOSE=true
        shift
        ;;
      -h | --help)
        echo "使い方: localai test [--only <名前>]... [--list] [-v]"
        return 0
        ;;
      *)
        die_usage "test の引数が不正です: $argument"
        ;;
    esac
  done

  if $list_only; then
    print_test_list
    return 0
  fi

  # 名前を検査する。未知の名前は、何も走らせる前に使い方の誤りとして返す。
  local name known candidate
  if [ "${#selected[@]}" -eq 0 ]; then
    selected=("${TEST_NAMES[@]}" "${TEST_SKIP_NAMES[@]}")
  fi
  for name in "${selected[@]}"
  do
    known=false
    for candidate in "${TEST_NAMES[@]}" "${TEST_SKIP_NAMES[@]}"
    do
      if [ "$candidate" = "$name" ]; then
        known=true
      fi
    done
    if ! $known; then
      die_usage "未知の試験名: $name（./localai test --list）"
    fi
  done

  # 走らせる試験があるのに uv が無ければ、全部が走らない。SKIP にせず失敗として知らせる。
  local needs_uv=false
  for name in "${selected[@]}"
  do
    if [ -n "$(test_required_path "$name")" ]; then
      needs_uv=true
    fi
  done
  if $needs_uv && ! command -v uvx >/dev/null 2>&1; then
    echo "エラー: uvx が無いので試験を走らせられません。" >&2
    echo "  curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
    return 1
  fi

  echo "== localai test =="
  cd -- "$REPO_ROOT"
  local required_path started_sec
  for name in "${selected[@]}"
  do
    if [ -n "$(test_skip_reason "$name")" ]; then
      report_test SKIP "$name" "$(test_skip_reason "$name")"
      continue
    fi
    required_path="$(test_required_path "$name")"
    if [ ! -e "$REPO_ROOT/$required_path" ]; then
      report_test SKIP "$name" "$required_path が無い（この clone に含まれない）"
      continue
    fi
    started_sec="$SECONDS"
    run_test_command test_body "$name"
    finish_test "$name" "$((SECONDS - started_sec))"
  done

  echo
  echo "結果: OK $TEST_OK_COUNT / FAIL $TEST_FAIL_COUNT / SKIP $TEST_SKIP_COUNT"
  [ "$TEST_FAIL_COUNT" -eq 0 ]
}

# ================================================================ 入口

main() {
  if [ "$#" -eq 0 ]; then
    usage
    return 0
  fi
  local subcommand="$1"
  shift
  case "$subcommand" in
    -h | --help | help)
      usage
      ;;
    doctor)
      run_doctor
      ;;
    install)
      run_install "$@"
      ;;
    start | stop | restart)
      run_control "$subcommand" "${1:-}"
      ;;
    status)
      run_status "${1:-}"
      ;;
    test)
      run_test "$@"
      ;;
    *)
      echo "エラー: 未知のサブコマンド: $subcommand" >&2
      usage >&2
      return 2
      ;;
  esac
}

main "$@"
