#!/usr/bin/env bash
# localai: このリポジトリの導入・起動・点検の入口。
#
#   doctor     この機体で動かせるかを点検する（OK / WARN / NG）
#   install    各ツールの setup-server.sh を呼ぶ（Ollama は公式の手順を表示するだけ）
#   start | stop | restart | status   サービスの起動・停止・状態
#   test       GPU を使わない試験をまとめて走らせる
#
# サービスの起動・停止は、入口ページ（portal、既定 8080）が応答していればその HTTP API を使う
# （GPU の排他と Ollama のアンロードを portal が行う）。応答していなければ systemctl --user を直接使う。
# リポジトリの場所はこのファイルの位置から決める（どこへ clone してもよい）。
set -euo pipefail

# symlink 経由（例: ~/.local/bin/localai）で呼ばれても、リポジトリの実体の位置を指す。
SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
REPO_ROOT="$(cd -P -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"

# 外から差し替えられる値。試験（scripts/tests/test_localai.py）と、既定外の構成で使う。
PORTAL_URL="${LOCALAI_PORTAL_URL:-http://127.0.0.1:8080}"
OLLAMA_URL="${LOCALAI_OLLAMA_URL:-http://127.0.0.1:11434}"
OS_RELEASE_FILE="${LOCALAI_OS_RELEASE:-/etc/os-release}"
MEMINFO_FILE="${LOCALAI_MEMINFO:-/proc/meminfo}"
CUDA_ROOT="${LOCALAI_CUDA_ROOT:-/usr/local}"

# 主モデル（knowledge/10-silver/areas/env.md）。
OLLAMA_MODEL="qwen3.8:27b"

# 色は端末に出すときだけ（NO_COLOR があれば付けない）。
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  COLOR_OK=$'\033[32m'
  COLOR_WARN=$'\033[33m'
  COLOR_NG=$'\033[31m'
  COLOR_RESET=$'\033[0m'
else
  COLOR_OK=""
  COLOR_WARN=""
  COLOR_NG=""
  COLOR_RESET=""
fi

# サービスの一覧。key はそのまま systemd の user unit 名と portal の API の key になる。
SERVICE_KEYS=(portal open-webui strata strata-coder strata-official strata-official-iq3s strata-swift pixal3d hunyuan3d comfyui)
# 起動前に ollama のモデルと他の GPU サービスを降ろす必要があるもの（tools/portal/portal.py の GPU_EXCLUSIVE_KEYS）。
GPU_SERVICE_KEYS=(strata strata-coder strata-official strata-official-iq3s strata-swift pixal3d hunyuan3d comfyui)

usage() {
  cat <<EOF
使い方: localai <サブコマンド> [引数...]

  doctor                       この機体で動かせるかを点検する。NG があれば終了コード 1
  install [<名前> [引数...]]   導入。名前なしで一覧と最小の導入経路を表示する
                               名前: portal strata pixal3d comfyui hunyuan3d qwen-worker ollama
                               引数は tools/<名前>/setup-server.sh へそのまま渡す
                               （例: localai install strata --model coder）
  start   <サービス>           起動する
  stop    <サービス>           停止する
  restart <サービス>           停止してから起動する
  status  [<サービス>]         状態を表示する（名前なしで全部）
                               サービス: ${SERVICE_KEYS[*]}
  test [--only <名前>]         GPU を使わない試験をまとめて走らせる（--list で名前の一覧）
  -h | --help                  この説明を表示する

入口ページ（portal、既定 ${PORTAL_URL}）が応答していれば、start / stop / restart はその API を使う。
応答していなければ systemctl --user を直接使う（その場合、GPU を使うサービスは他の GPU サービスを
自分で止めること）。

終了コード: 0 成功 / 1 失敗（NG・試験の失敗・操作の失敗） / 2 使い方の誤り
EOF
}

die_usage() {
  echo "エラー: $1" >&2
  echo "使い方は 'localai --help' を参照してください。" >&2
  exit 2
}

# ---------------------------------------------------------------- 共通の道具

# 外部コマンドをタイムアウト付きで呼ぶ。timeout が無い機体ではそのまま呼ぶ。
run_with_timeout() {
  local timeout_sec="$1"
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$timeout_sec" "$@"
  else
    "$@"
  fi
}

# HTTP 要求を送る。本文を HTTP_BODY に、ステータスを HTTP_CODE に入れる（接続できなければ 000）。
# 使い方: http_request <GET|POST> <URL> <タイムアウト秒> [<ヘッダ "名前: 値">]
http_request() {
  local method="$1"
  local url="$2"
  local timeout_sec="$3"
  local header="${4:-}"
  local response=""
  HTTP_BODY=""
  HTTP_CODE="000"
  if command -v curl >/dev/null 2>&1; then
    local curl_args=(-sS --max-time "$timeout_sec" -X "$method")
    if [ -n "$header" ]; then
      curl_args+=(-H "$header")
    fi
    # -w で本文のあとに改行とステータスを足す。接続できないときは curl が非 0 で終わる。
    if response="$(curl "${curl_args[@]}" -w $'\n%{http_code}' "$url" 2>/dev/null)"; then
      HTTP_CODE="${response##*$'\n'}"
      HTTP_BODY="${response%$'\n'*}"
    fi
  elif command -v python3 >/dev/null 2>&1; then
    if response="$(python3 -I -c '
import sys
import urllib.error
import urllib.request

method, url, timeout_sec, header = sys.argv[1], sys.argv[2], float(sys.argv[3]), sys.argv[4]
headers = {}
if header:
    name, _, value = header.partition(": ")
    headers[name] = value
request = urllib.request.Request(url, data=b"" if method == "POST" else None, headers=headers, method=method)
try:
    with urllib.request.urlopen(request, timeout=timeout_sec) as reply:
        body, code = reply.read(), reply.status
except urllib.error.HTTPError as error:
    body, code = error.read(), error.code
except Exception:
    sys.exit(1)
sys.stdout.write(body.decode("utf-8", "replace") + "\n" + str(code))
' "$method" "$url" "$timeout_sec" "$header" 2>/dev/null)"; then
      HTTP_CODE="${response##*$'\n'}"
      HTTP_BODY="${response%$'\n'*}"
    fi
  fi
  [ "$HTTP_CODE" != "000" ]
}

# 127.0.0.1 の指定ポートが待受中かどうか（ss が無ければ /dev/tcp で接続して確かめる）。
port_is_listening() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    [ -n "$(ss -H -ltn "sport = :$port" 2>/dev/null)" ]
  else
    run_with_timeout 1 bash -c "cat < /dev/null > /dev/tcp/127.0.0.1/$port" 2>/dev/null
  fi
}

# サービス key の待受ポート（tools/portal/portal.py の SERVICES と同じ）。
service_port() {
  case "$1" in
    portal) echo 8080 ;;
    open-webui) echo 8081 ;;
    strata) echo 8082 ;;
    strata-coder) echo 8083 ;;
    strata-official) echo 8084 ;;
    strata-official-iq3s) echo 8085 ;;
    strata-swift) echo 8086 ;;
    hunyuan3d) echo 7860 ;;
    pixal3d) echo 7861 ;;
    comfyui) echo 8188 ;;
    *) echo "" ;;
  esac
}

# 未導入のときに案内する導入手順。
install_hint() {
  case "$1" in
    portal) echo "./localai install portal" ;;
    strata) echo "./localai install strata" ;;
    strata-coder) echo "./localai install strata --model coder" ;;
    strata-official) echo "./localai install strata --model official" ;;
    strata-official-iq3s) echo "./localai install strata --model official-iq3s" ;;
    strata-swift) echo "./localai install strata --model swift" ;;
    pixal3d | comfyui | hunyuan3d) echo "./localai install $1" ;;
    open-webui) echo "Open WebUI はこのリポジトリの外にある。systemd の user unit open-webui.service を用意する（tools/portal/README.md）" ;;
    *) echo "./localai install" ;;
  esac
}

is_service_key() {
  local candidate="$1"
  local key
  for key in "${SERVICE_KEYS[@]}"
  do
    if [ "$key" = "$candidate" ]; then
      return 0
    fi
  done
  return 1
}

is_gpu_service_key() {
  local candidate="$1"
  local key
  for key in "${GPU_SERVICE_KEYS[@]}"
  do
    if [ "$key" = "$candidate" ]; then
      return 0
    fi
  done
  return 1
}

# ================================================================ doctor

OK_COUNT=0
WARN_COUNT=0
NG_COUNT=0

# 点検の 1 項目を表示して数える。使い方: report_item <OK|WARN|NG> <項目> <理由> [<対処>]
report_item() {
  local level="$1"
  local label="$2"
  local detail="$3"
  local hint="${4:-}"
  local color=""
  local mark=""
  case "$level" in
    OK)
      OK_COUNT=$((OK_COUNT + 1))
      color="$COLOR_OK"
      mark="[ OK ]"
      ;;
    WARN)
      WARN_COUNT=$((WARN_COUNT + 1))
      color="$COLOR_WARN"
      mark="[WARN]"
      ;;
    *)
      NG_COUNT=$((NG_COUNT + 1))
      color="$COLOR_NG"
      mark="[ NG ]"
      ;;
  esac
  printf '%s%s%s %s: %s\n' "$color" "$mark" "$COLOR_RESET" "$label" "$detail"
  if [ -n "$hint" ]; then
    printf '       対処: %s\n' "$hint"
  fi
}

os_release_value() {
  local key="$1"
  if [ ! -r "$OS_RELEASE_FILE" ]; then
    return 0
  fi
  grep -E "^${key}=" "$OS_RELEASE_FILE" | head -n 1 | cut -d= -f2- | tr -d '"' || true
}

check_os() {
  local kernel_name
  kernel_name="$(uname -s)"
  local os_id os_version os_pretty
  os_id="$(os_release_value ID)"
  os_version="$(os_release_value VERSION_ID)"
  os_pretty="$(os_release_value PRETTY_NAME)"
  if [ "$kernel_name" != "Linux" ]; then
    report_item WARN "OS" "$kernel_name は未対応（systemd・CUDA・bash を前提にする）" \
      "動作確認は Ubuntu 24.04 のみ。docs/hardware-requirements.md を参照"
  elif [ "$os_id" = "ubuntu" ] && [ "$os_version" = "24.04" ]; then
    report_item OK "OS" "${os_pretty:-Ubuntu 24.04}"
  else
    report_item WARN "OS" "${os_pretty:-不明}（Ubuntu 24.04 ではない）" \
      "動作確認は Ubuntu 24.04 のみ。ほかの OS では導入の途中で止まることがある"
  fi
}

check_gpu() {
  if ! command -v nvidia-smi >/dev/null 2>&1; then
    report_item WARN "GPU" "nvidia-smi が無い（GPU なし）" \
      "GPU が無くても portal・評価レポートの閲覧・試験（./localai test）だけは使える。推論と 3D 生成には NVIDIA GPU とドライバが要る"
    return 0
  fi
  local gpu_output
  if ! gpu_output="$(run_with_timeout 10 nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader,nounits 2>&1)"; then
    report_item WARN "GPU" "nvidia-smi が失敗した（${gpu_output%%$'\n'*}）" \
      "ドライバが読み込まれているか、nvidia-smi を直接実行して確かめる"
    return 0
  fi

  local gpu_index=0
  local first_driver=""
  local gpu_name gpu_mib gpu_driver
  while IFS=',' read -r gpu_name gpu_mib gpu_driver
  do
    # 前後の空白を落とす
    gpu_name="${gpu_name#"${gpu_name%%[![:space:]]*}"}"
    gpu_mib="${gpu_mib//[[:space:]]/}"
    gpu_driver="${gpu_driver//[[:space:]]/}"
    if [ -z "$gpu_name" ]; then
      continue
    fi
    if [ -z "$first_driver" ]; then
      first_driver="$gpu_driver"
    fi
    if [[ ! "$gpu_mib" =~ ^[0-9]+$ ]]; then
      report_item WARN "GPU $gpu_index" "$gpu_name（VRAM を読めない: ${gpu_mib:-空}）"
    # 24 GiB のカードは 24564〜24576 MiB と出る。24000 MiB 未満を「24 GiB 未満」とする。
    elif [ "$gpu_mib" -lt 24000 ]; then
      report_item WARN "GPU $gpu_index" "$gpu_name、VRAM ${gpu_mib} MiB（24 GiB 未満）" \
        "A30 24GB 前提。Qwen3.8-27B・Strata・3D 生成は VRAM の取り合いで動かない可能性が高い（docs/hardware-requirements.md）"
    else
      report_item OK "GPU $gpu_index" "$gpu_name、VRAM ${gpu_mib} MiB"
    fi
    gpu_index=$((gpu_index + 1))
  done <<<"$gpu_output"

  if [ "$gpu_index" -eq 0 ]; then
    report_item WARN "GPU" "nvidia-smi が GPU を 1 枚も返さなかった"
    return 0
  fi

  # CUDA 13 系（Strata・Hunyuan3D）は配布の engine が MIN_DRIVER = 580（tools/strata/README.md）。
  local driver_major="${first_driver%%.*}"
  if [[ ! "$driver_major" =~ ^[0-9]+$ ]]; then
    report_item WARN "NVIDIA ドライバ" "版を読めない（${first_driver:-空}）"
  elif [ "$driver_major" -lt 580 ]; then
    report_item WARN "NVIDIA ドライバ" "$first_driver（580 未満）" \
      "CUDA 13 系を使う Strata・Hunyuan3D は 580 以上が要る。ドライバを上げる"
  else
    report_item OK "NVIDIA ドライバ" "$first_driver"
  fi
}

check_cuda() {
  # 版:使うツール。環境は knowledge/10-silver/areas/env.md、ツールごとの版は各 README にある。
  local entry version users cuda_dir
  for entry in "13.2:Strata・Hunyuan3D" "12.6:Pixal3D・ComfyUI"
  do
    version="${entry%%:*}"
    users="${entry#*:}"
    cuda_dir="$CUDA_ROOT/cuda-$version"
    if [ -x "$cuda_dir/bin/nvcc" ]; then
      report_item OK "CUDA $version" "$cuda_dir（$users が使う）"
    elif [ -d "$cuda_dir" ]; then
      report_item WARN "CUDA $version" "$cuda_dir に bin/nvcc が無い（$users が使う）" \
        "CUDA Toolkit $version を入れ直す。入れなくても、ほかのツールは使える"
    else
      report_item WARN "CUDA $version" "$cuda_dir が無い（$users が使う）" \
        "NVIDIA の CUDA Toolkit $version を入れる。入れなくても、ほかのツールは使える"
    fi
  done
}

check_ram() {
  local mem_kib=""
  if [ -r "$MEMINFO_FILE" ]; then
    mem_kib="$(awk '/^MemTotal:/ {print $2; exit}' "$MEMINFO_FILE")"
  fi
  if [[ ! "$mem_kib" =~ ^[0-9]+$ ]]; then
    report_item WARN "RAM" "総量を読めない（$MEMINFO_FILE）"
    return 0
  fi
  local mem_mib=$((mem_kib / 1024))
  local mem_gib
  mem_gib="$(awk -v kib="$mem_kib" 'BEGIN { printf "%.1f", kib / 1048576 }')"
  if [ "$mem_mib" -lt 32768 ]; then
    report_item WARN "RAM" "${mem_gib} GiB（32 GiB 未満）" \
      "64 GiB 推奨。3D 生成の低 VRAM モードと Strata は RAM を強く使い、足りないとデスクトップごと止まることがある"
  elif [ "$mem_mib" -lt 61440 ]; then
    report_item OK "RAM" "${mem_gib} GiB（64 GiB 推奨。Strata の汎用版・公式版は RAM を約 50 GiB 使う）"
  else
    report_item OK "RAM" "${mem_gib} GiB"
  fi
}

# 指定パスのあるファイルシステムの空きを点検する。使い方: check_disk_for <項目> <パス>
# 結果としてマウント先を DISK_MOUNT_POINT に入れる（同じファイルシステムの二重表示を避けるため）。
check_disk_for() {
  local label="$1"
  local target_path="$2"
  local df_line=""
  DISK_MOUNT_POINT=""
  if ! df_line="$(df -Pk -- "$target_path" 2>/dev/null | awk 'NR == 2 {print $4, $6}')" || [ -z "$df_line" ]; then
    report_item WARN "$label" "空きを読めない（$target_path）"
    return 0
  fi
  local free_kib="${df_line%% *}"
  DISK_MOUNT_POINT="${df_line#* }"
  if [[ ! "$free_kib" =~ ^[0-9]+$ ]]; then
    report_item WARN "$label" "空きを読めない（$target_path）"
    return 0
  fi
  local free_gib=$((free_kib / 1048576))
  if [ "$free_kib" -lt 104857600 ]; then
    report_item WARN "$label" "空き ${free_gib} GiB（100 GiB 未満。$target_path は $DISK_MOUNT_POINT）" \
      "Strata は約 100 GB、Pixal3D 約 30 GB、Hunyuan3D 約 23 GB、ComfyUI 約 16 GB を取得する。入れるものを選ぶか、空きを作る"
  else
    report_item OK "$label" "空き ${free_gib} GiB（$target_path は $DISK_MOUNT_POINT）"
  fi
}

check_disk() {
  check_disk_for "ディスク（ホーム）" "$HOME"
  local home_mount="$DISK_MOUNT_POINT"
  # 重みはリポジトリの中（tools/*/models）に置く。ホームと別のファイルシステムなら、そちらも見る。
  local repo_mount
  repo_mount="$(df -Pk -- "$REPO_ROOT" 2>/dev/null | awk 'NR == 2 {print $6}')"
  if [ -n "$repo_mount" ] && [ "$repo_mount" != "$home_mount" ]; then
    check_disk_for "ディスク（リポジトリ）" "$REPO_ROOT"
  fi
}

check_tools() {
  if command -v git >/dev/null 2>&1; then
    report_item OK "git" "$(git --version)"
  else
    report_item NG "git" "無い" "sudo apt-get install -y git"
  fi

  if command -v uv >/dev/null 2>&1; then
    local uv_note=""
    if ! command -v uvx >/dev/null 2>&1; then
      uv_note="（uvx が無い。./localai test に要る）"
    fi
    report_item OK "uv" "$(uv --version)${uv_note}"
  else
    report_item NG "uv" "無い（Python の環境づくりと ./localai test に要る）" \
      "curl -LsSf https://astral.sh/uv/install.sh | sh"
  fi

  if ! command -v python3 >/dev/null 2>&1; then
    report_item NG "python3" "無い" "sudo apt-get install -y python3"
    return 0
  fi
  local python_version
  python_version="$(python3 -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null || true)"
  local python_major="${python_version%%.*}"
  local python_rest="${python_version#*.}"
  local python_minor="${python_rest%%.*}"
  if [[ ! "$python_major" =~ ^[0-9]+$ ]] || [[ ! "$python_minor" =~ ^[0-9]+$ ]]; then
    report_item WARN "python3" "版を読めない"
  elif [ "$python_major" -gt 3 ] || { [ "$python_major" -eq 3 ] && [ "$python_minor" -ge 12 ]; }; then
    report_item OK "python3" "$python_version"
  else
    report_item WARN "python3" "$python_version（3.12 未満）" \
      "入口ページ（portal）はこの版で動く。各ツールの Python は uv が 3.12 などを取得する"
  fi
}

check_systemd_user() {
  if ! command -v systemctl >/dev/null 2>&1; then
    report_item WARN "systemctl --user" "systemctl が無い" \
      "サービスの unit が使えない。各ツールの run-<ツール> serve を手で起動する"
  elif run_with_timeout 5 systemctl --user show-environment >/dev/null 2>&1; then
    report_item OK "systemctl --user" "動く"
  else
    report_item WARN "systemctl --user" "ユーザーの systemd に接続できない" \
      "SSH 越しなら XDG_RUNTIME_DIR を確かめ、loginctl enable-linger \$USER のあと入り直す。コンテナでは使えない"
  fi
}

check_ollama() {
  if command -v ollama >/dev/null 2>&1; then
    local ollama_version
    ollama_version="$(run_with_timeout 5 ollama --version 2>&1 || true)"
    report_item OK "ollama" "${ollama_version%%$'\n'*}"
  else
    report_item WARN "ollama" "無い" "./localai install ollama（Qwen と Open WebUI に要る。Strata・3D 生成には要らない）"
  fi

  if http_request GET "$OLLAMA_URL/api/tags" 3 && [ "$HTTP_CODE" = "200" ]; then
    report_item OK "Ollama API" "$OLLAMA_URL が応答する"
    if [[ "$HTTP_BODY" == *"\"$OLLAMA_MODEL\""* ]]; then
      report_item OK "Ollama のモデル" "$OLLAMA_MODEL がある"
    else
      report_item WARN "Ollama のモデル" "$OLLAMA_MODEL が無い" "ollama pull $OLLAMA_MODEL（約 17 GB）"
    fi
  else
    report_item WARN "Ollama API" "$OLLAMA_URL が応答しない" \
      "systemctl status ollama、または ollama serve で起動する"
    report_item WARN "Ollama のモデル" "$OLLAMA_MODEL の有無を確認できない（Ollama API が応答しない）"
  fi
}

# 待受ポートの使用者の名前（ss -p は自分のプロセスしか出せない。分からなければ空）。
port_owner_name() {
  local port="$1"
  if ! command -v ss >/dev/null 2>&1; then
    return 0
  fi
  ss -H -ltnp "sport = :$port" 2>/dev/null | sed -n 's/.*users:(("\([^"]*\)".*/\1/p' | head -n 1
}

# このポートを使うはずのサービス（unit）が動いているか。
port_belongs_to_unit() {
  local unit="$1"
  local unit_state=""
  if ! command -v systemctl >/dev/null 2>&1; then
    return 1
  fi
  if [ "$unit" = "ollama" ]; then
    unit_state="$(systemctl is-active ollama 2>/dev/null || true)"
  else
    unit_state="$(run_with_timeout 5 systemctl --user is-active "$unit" 2>/dev/null || true)"
  fi
  [ "$unit_state" = "active" ] || [ "$unit_state" = "activating" ]
}

check_ports() {
  local entry port unit owner
  for entry in 8080:portal 8081:open-webui 8082:strata 8083:strata-coder 8084:strata-official \
    8085:strata-official-iq3s 8086:strata-swift 7860:hunyuan3d 7861:pixal3d 8188:comfyui 11434:ollama
  do
    port="${entry%%:*}"
    unit="${entry#*:}"
    if ! port_is_listening "$port"; then
      report_item OK "ポート $port" "空き（$unit は停止中）"
      continue
    fi
    owner="$(port_owner_name "$port")"
    if port_belongs_to_unit "$unit" || [ "$owner" = "$unit" ]; then
      report_item OK "ポート $port" "$unit が使用中"
    else
      report_item WARN "ポート $port" "使用中（使用者: ${owner:-不明。ほかのユーザーのプロセス}。$unit 用のポート）" \
        "ss -ltnp | grep :$port で使用者を確かめ、止めるか、$unit を使わない"
    fi
  done
}

